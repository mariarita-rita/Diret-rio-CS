{
  "manifest_version": 3,
  "name": "Londrisoft - Criar projeto de implantação",
  "version": "1.1.0",
  "description": "Na tela de um negócio ganho no Moskit, abre o formulário de criação do projeto de implantação já preenchido e envia o formulário do financeiro com um clique.",
  "content_scripts": [
    {
      "matches": ["https://app.moskitcrm.com/*", "https://app.ollow.com.br/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://diretoriocs.vercel.app/*"],
      "js": ["marca.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://docs.google.com/forms/d/e/*/viewform*", "https://docs.google.com/forms/d/e/*/formResponse*"],
      "js": ["financeiro.js"],
      "run_at": "document_idle"
    }
  ]
}
