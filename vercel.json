{
  "rewrites": [
    { "source": "/formulario-tributario/:codigo", "destination": "/api/formulario-tributario?codigo=:codigo" }
  ],
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron?job=relatorio-finalizacao", "schedule": "0 10 * * *" },
    { "path": "/api/cron?job=snapshot-indicadores", "schedule": "10 10 * * *" },
    { "path": "/api/cron?job=analise-reunioes", "schedule": "45 15 * * *" },
    { "path": "/api/cron?job=analise-reunioes", "schedule": "0 3 * * *" }
  ]
}
